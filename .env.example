# Database (Neon) — pooled URL must use -pooler host + pgbouncer=true
DATABASE_URL="postgresql://user:password@host-pooler/neondb?sslmode=require&pgbouncer=true&connect_timeout=15&pool_timeout=15"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
ADMIN_EMAIL="admin@bekography.com"
# Generate with: npm run hash-password -- your-password
ADMIN_PASSWORD_HASH=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
WHATSAPP_NUMBER="905469370464"

# Bakım modu — production'da true yapın; admin oturumu siteyi görmeye devam eder
MAINTENANCE_MODE="false"
# MAINTENANCE_MESSAGE="Bekography yeni paketler ve hizmetleriyle yenileniyor."

# Google Maps / Places (yorumlar + harita)
GOOGLE_API_KEY=""
GOOGLE_PLACE_ID=""
# İstemci haritası için (Maps JavaScript API + Embed API açık olmalı)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# İsteğe bağlı: istemci tarafında place_id (yoksa GOOGLE_PLACE_ID kullanılır)
NEXT_PUBLIC_GOOGLE_PLACE_ID=""

# Vercel Blob
NEXT_PUBLIC_BLOB_BASE_URL=""
BLOB_READ_WRITE_TOKEN=""
